# Copy this file to ".env" and fill in your own values.
# The real .env file is git-ignored and is never uploaded or committed.
#
# Use a Gmail APP PASSWORD (16 characters), not your normal account password.
# Generate one at: https://myaccount.google.com/apppasswords
# Spaces are fine - they are stripped automatically.

IMAP_USER=yourtestaddr@gmail.com
IMAP_PASS=abcd efgh ijkl mnop

# Optional - only needed for non-Gmail providers.
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
